{
 "uid": "quantykube-stage",
 "title": "QuantyKube on stage",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "tags": [
  "quantykube"
 ],
 "editable": true,
 "graphTooltip": 1,
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "10s",
   "30s"
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Runtime memory, w1 + w2",
   "description": "Resident memory of the container runtime and everything it starts besides the containers: containerd, a shim and a pause per pod, runc; or one quantykube runtime.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "text": {
     "titleSize": 22,
     "valueSize": 64
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(namedprocess_namegroup_memory_bytes{memtype=\"resident\",node=~\"w1|w2\",groupname=~\"containerd|containerd-shim|runc|pause|quantykube-runtime\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": false
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Runtime processes, w1 + w2",
   "description": "How many processes the runtime needs for the pods on the two workers.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "text": {
     "titleSize": 22,
     "valueSize": 64
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(namedprocess_namegroup_num_procs{node=~\"w1|w2\",groupname=~\"containerd|containerd-shim|runc|pause|quantykube-runtime\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": false
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Store memory, cp",
   "description": "etcd, or QuantyKube's store, on the control plane node.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "text": {
     "titleSize": 22,
     "valueSize": 64
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(namedprocess_namegroup_memory_bytes{memtype=\"resident\",node=\"cp\",groupname=~\"etcd|quantykube-store\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": false
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "30 pods start in, slowest node",
   "description": "scripts/load.sh: 30 more pods on a node, from kubectl apply until all are Ready; the slower of the two nodes.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "text": {
     "titleSize": 22,
     "valueSize": 64
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(quantykube_load_start_seconds)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": false
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Runtime memory per node",
   "description": "With 60 pods on each node, 90 while load.sh adds its 30.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 11
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "custom": {
      "lineWidth": 4,
      "fillOpacity": 12,
      "drawStyle": "line",
      "pointSize": 9,
      "showPoints": "auto",
      "spanNulls": true,
      "axisSoftMin": 0
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "w1"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#2f6fd6"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "w2"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e0832b"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node) (namedprocess_namegroup_memory_bytes{memtype=\"resident\",node=~\"w1|w2\",groupname=~\"containerd|containerd-shim|runc|pause|quantykube-runtime\"})",
     "legendFormat": "{{node}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
