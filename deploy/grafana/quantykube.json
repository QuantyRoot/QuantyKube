      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (namedprocess_namegroup_memory_bytes{memtype=\"resident\",groupname=~\"containerd|containerd-shim|runc|pause|quantykube-runtime\"})",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
