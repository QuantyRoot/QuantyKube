{
  "uid": "quantykube",
  "title": "QuantyKube: before and after",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "quantykube"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Store memory (cp)",
      "description": "Resident memory of the cluster's store: etcd before the move, QuantyKube's store after.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (groupname) (namedprocess_namegroup_memory_bytes{memtype=\"resident\",node=\"cp\",groupname=~\"etcd|quantykube-store\"})",
          "legendFormat": "{{groupname}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runtime memory per worker",
      "description": "Resident memory of the container runtime: containerd, its shims, runc and pause containers on containerd; quantykube runtime on QuantyKube.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
